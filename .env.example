# Пример локальной конфигурации. Скопируйте в .env и при необходимости измените.
# Пометка «обязательно» означает, что без переменной приложение не стартует.

# Приложение (обязательно)
APP_ENV=local
APP_BASE_URL=http://localhost:8092
SESSION_SECRET=change-me-to-a-long-random-string
MIGRATIONS_DIR=migrations
# Необязательно: название продукта в шапке, подвале и заголовках. По умолчанию «Верно».
BRAND_NAME=Верно

# HTTP (обязательно)
HTTP_ADDR=:8092
# Таймауты и лимит тела имеют безопасные значения по умолчанию.
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
HTTP_MAX_BODY_BYTES=1048576

# PostgreSQL (обязательно)
DATABASE_URL=postgres://oge_ege:oge_ege@localhost:54327/oge_ege?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Логирование (обязательно)
LOG_LEVEL=info

# SMTP (обязательно, кроме SMTP_USER и SMTP_PASSWORD)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.ru
SMTP_TLS=false

# S3 / MinIO (обязательно)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=oge-ege
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=us-east-1

# Ограничение частоты запросов (обязательно)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120
