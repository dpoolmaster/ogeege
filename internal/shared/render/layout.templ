package render

templ Layout(chrome Chrome, title string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ DocumentTitle(title, chrome.BrandName()) }</title>
			<link rel="icon" href={ FaviconPath() } type="image/svg+xml"/>
			<link rel="preload" href={ FontsPath("golos-text-cyrillic.woff2") } as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<link rel="stylesheet" href={ StylesPath() }/>
		</head>
		<body>
			<a class="v-skip-link" href="#main-content">Перейти к содержимому</a>
			<main id="main-content" class="container auth-page">
				{ children... }
			</main>
		</body>
	</html>
}
