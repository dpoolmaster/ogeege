package publicsite

import (
	"oge-ege/internal/content"
	"oge-ege/internal/shared/render"
	"oge-ege/internal/shared/render/ui"
)

templ pageLayout(seo SEOMetadata, crumbs []Breadcrumb, brand string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ render.DocumentTitle(seo.Title, brandName(brand)) }</title>
			if seo.Description != "" {
				<meta name="description" content={ seo.Description }/>
			}
			if seo.NoIndex {
				<meta name="robots" content="noindex, nofollow"/>
			} else {
				<meta name="robots" content="index, follow"/>
			}
			if seo.Canonical != "" {
				<link rel="canonical" href={ seo.Canonical }/>
			}
			if seo.OGTitle != "" {
				<meta property="og:title" content={ seo.OGTitle }/>
			}
			if seo.OGDescription != "" {
				<meta property="og:description" content={ seo.OGDescription }/>
			}
			if seo.OGImage != "" {
				<meta property="og:image" content={ seo.OGImage }/>
			}
			<meta property="og:type" content="website"/>
			<link rel="icon" href={ render.FaviconPath() } type="image/svg+xml"/>
			<link rel="preload" href={ render.FontsPath("golos-text-cyrillic.woff2") } as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"/>
			<link rel="stylesheet" href={ render.StylesPath() }/>
			<script defer src="/static/public/htmx.min.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
			<script defer src="/static/public/public.js"></script>
		</head>
		<body class="v-site">
			<a class="v-skip-link" href="#main-content">Перейти к содержимому</a>
			<header class="v-site-header">
				<div class="container v-site-header__inner">
					<a class="v-brand" href="/">{ brandName(brand) }</a>
					<nav aria-label="Основная навигация">
						<ul>
							<li><a href="/#tracks">Треки</a></li>
							<li><a href="/bank">Банк заданий</a></li>
							<li><a href="/diagnostics/demo">Демо-диагностика</a></li>
							<li><a href="/articles">Статьи</a></li>
							<li><a href="/login">Войти</a></li>
							<li><a class="v-btn v-btn--primary v-btn--sm" href="/register">Начать</a></li>
						</ul>
					</nav>
				</div>
			</header>
			<main id="main-content" class="container v-main">
				if len(crumbs) > 0 {
					@ui.Breadcrumbs(uiCrumbs(crumbs))
				}
				{ children... }
			</main>
			<footer class="v-site-footer">
				<div class="container v-site-footer__inner">
					<div>
						<p class="v-site-footer__brand">{ brandName(brand) }</p>
						<small>Открытый банк заданий, демо-диагностика и разборы.</small>
					</div>
					<nav aria-label="Навигация в подвале">
						<ul>
							<li><a href="/#tracks">Треки</a></li>
							<li><a href="/bank">Банк заданий</a></li>
							<li><a href="/diagnostics/demo">Демо-диагностика</a></li>
							<li><a href="/articles">Статьи</a></li>
						</ul>
					</nav>
				</div>
			</footer>
		</body>
	</html>
}

templ HomePageView(page *HomePage) {
	@pageLayout(page.SEO, nil, page.Brand) {
		<section class="v-hero">
			<div class="v-hero__text">
				<h1>Подготовка к экзаменам</h1>
				<p class="v-lead">Открытый банк заданий, демо-диагностика и разборы без регистрации.</p>
				<div class="v-actions">
					<a class="v-btn v-btn--primary v-btn--md" href="/bank">Перейти в банк заданий</a>
					<a class="v-btn v-btn--secondary v-btn--md" href="/diagnostics/demo">Пройти демо-диагностику</a>
				</div>
			</div>
			<div class="v-hero__aside">
				@ui.Card(ui.CardProps{Title: "С чего начать", Meta: "Бесплатно и без регистрации"}) {
					<p>Пройдите короткую демо-диагностику и посмотрите, какие темы стоит повторить первыми.</p>
					<a class="v-btn v-btn--secondary v-btn--sm" href="/diagnostics/demo">Открыть демо</a>
				}
			</div>
		</section>
		<section id="tracks" class="v-section">
			<div class="v-section__head">
				<h2>Учебные треки</h2>
				<a href="/bank">Открыть банк заданий</a>
			</div>
			<div class="v-card-grid">
				for _, exam := range page.Exams {
					<article class={ "v-card v-track-card v-track-card--" + string(ui.SubjectTone(exam.Code)) }>
						<h3><a href={ "/tracks/" + exam.Code }>{ exam.Title }</a></h3>
						<p>Структура экзамена, темы и демо-диагностика.</p>
						<a class="v-btn v-btn--secondary v-btn--sm" href={ "/tracks/" + exam.Code }>Открыть трек</a>
					</article>
				}
			</div>
		</section>
		<section class="v-section">
			<div class="v-section__head">
				<h2>Как это работает</h2>
			</div>
			<ol class="v-steps">
				<li class="v-step">
					<span class="v-step__num">1</span>
					<h3>Пройдите демо-диагностику</h3>
					<p>Короткий набор заданий покажет текущий уровень без регистрации.</p>
				</li>
				<li class="v-step">
					<span class="v-step__num">2</span>
					<h3>Получите карту пробелов</h3>
					<p>Разбивка по темам и номерам КИМ покажет, что повторять первым.</p>
				</li>
				<li class="v-step">
					<span class="v-step__num">3</span>
					<h3>Занимайтесь по плану</h3>
					<p>Недельный план пересчитывается по результатам практики и пробников.</p>
				</li>
			</ol>
		</section>
		<section class="v-section">
			<div class="v-section__head">
				<h2>Частые вопросы</h2>
			</div>
			<div class="v-faq">
				<details>
					<summary>Нужна ли регистрация, чтобы начать?</summary>
					<p>Нет. Банк заданий, демо-диагностика и статьи доступны без аккаунта.</p>
				</details>
				<details>
					<summary>Как проверяются задания?</summary>
					<p>Задания части 1 проверяются автоматически по эталонному ответу, развёрнутые ответы — методистом.</p>
				</details>
				<details>
					<summary>Что даёт аккаунт?</summary>
					<p>Персональный план, карту пробелов, статистику прогресса и прогноз балла.</p>
				</details>
			</div>
		</section>
		<section class="v-cta">
			<div>
				<h2>Начните с бесплатной диагностики</h2>
				<p>Пять–семь заданий, итог по темам и рекомендации — без регистрации.</p>
			</div>
			<a class="v-btn v-btn--secondary v-btn--md" href="/diagnostics/demo">Пройти демо</a>
		</section>
	}
}

templ LandingView(page *LandingPage) {
	@pageLayout(page.SEO, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: page.Exam.Title, Path: "/tracks/" + page.Exam.Code},
	}, page.Brand) {
		<section class="v-hero">
			<div class="v-hero__text">
				<p class="v-eyebrow">Учебный трек</p>
				<h1>{ page.Exam.Title }</h1>
				<p class="v-lead">Структура экзамена, темы и демо-диагностика.</p>
				<div class="v-actions">
					<a class="v-btn v-btn--primary v-btn--md" href={ "/diagnostics/demo?exam=" + page.Exam.Code }>Пройти демо-диагностику</a>
					<a class="v-btn v-btn--secondary v-btn--md" href={ "/bank?exam=" + page.Exam.Code }>Открыть банк заданий</a>
				</div>
			</div>
			<div class="v-hero__aside">
				@ui.Card(ui.CardProps{Title: "Факты экзамена", Meta: "Актуальный учебный год"}) {
					if page.Year != nil {
						<ul class="v-facts">
							for _, fact := range examFacts(page) {
								<li><strong>{ fact.Value }</strong><span>{ fact.Label }</span></li>
							}
						</ul>
					} else {
						<p>Опубликованный учебный год пока не добавлен.</p>
					}
				}
			</div>
		</section>
		<section class="v-section">
			<div class="v-two-col">
				<div>
					<h2>Структура экзамена</h2>
					if page.Year != nil {
						<p>Учебный год { page.Year.Year }, длительность { page.Year.DurationMinutes } минут.</p>
						@ui.Table(ui.TableProps{
							Head: []string{"№", "Часть", "Тип ответа", "Баллы"},
							Rows: kimRows(page.KimNumbers),
							Caption: "Структура экзамена",
						})
					} else {
						<p>Опубликованный учебный год пока не добавлен. Оставьте заявку, и мы сообщим о старте подготовки.</p>
					}
				</div>
				<div>
					<h2>Записаться на подготовку</h2>
					@leadForm("/leads", page.Exam.Code, nil, false)
				</div>
			</div>
		</section>
		if len(page.Topics) > 0 {
			<section class="v-section">
				<h2>Темы</h2>
				<div class="v-tag-list">
					for _, topic := range page.Topics {
						@ui.Badge(ui.ToneNeutral, topic.Title)
					}
				</div>
			</section>
		}
		<section class="v-cta">
			<div>
				<h2>Проверьте себя на демо</h2>
				<p>Короткий набор заданий и итог с разбивкой по темам — без регистрации.</p>
			</div>
			<a class="v-btn v-btn--secondary v-btn--md" href={ "/diagnostics/demo?exam=" + page.Exam.Code }>Начать демо</a>
		</section>
	}
}

templ BankView(page *BankPage) {
	@pageLayout(page.SEO, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Банк заданий", Path: "/bank"},
	}, page.Brand) {
		<hgroup>
			<h1>Открытый банк заданий</h1>
			<p>Только опубликованные задания с автоматической проверкой.</p>
		</hgroup>
		<form method="get" action="/bank" hx-get="/hx/bank" hx-target="#bank-results" hx-push-url="true" class="v-form v-bank-filter">
			<div class="v-grid-3">
				<div class="v-field">
					<label for="field-exam">Трек</label>
					<select id="field-exam" name="exam">
						<option value="">Все треки</option>
						for _, exam := range page.Exams {
							<option value={ exam.Code } selected?={ exam.Code == page.Filter.ExamCode }>{ exam.Title }</option>
						}
					</select>
				</div>
				@ui.Field(ui.FieldProps{Label: "Номер КИМ", Name: "kim", Type: "number", Value: intString(page.Filter.KimNumber)})
				<div class="v-field">
					<label for="field-topic">Тема</label>
					<select id="field-topic" name="topic">
						<option value="">Все темы</option>
						for _, topic := range page.Topics {
							<option value={ topic.ID.String() } selected?={ page.Filter.TopicID != nil && *page.Filter.TopicID == topic.ID }>{ topic.Title }</option>
						}
					</select>
				</div>
			</div>
			@ui.Button(ui.ButtonProps{Label: "Показать задания", Type: "submit", Variant: ui.ButtonPrimary})
		</form>
		<div class="v-bank-layout">
			<div id="bank-results">
				@BankResultsView(page)
			</div>
			<aside class="v-bank-aside">
				<h2 class="v-bank-aside__title">Фильтры</h2>
				<p>Выбранные фильтры сохраняются в адресе — ссылкой можно поделиться.</p>
				@ui.Button(ui.ButtonProps{Label: "Сбросить фильтры", Href: "/bank", Variant: ui.ButtonGhost, Size: ui.ButtonSmall})
			</aside>
		</div>
	}
}

templ BankResultsView(page *BankPage) {
	if len(page.Tasks) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			Title: "Подходящих заданий пока нет",
			Text: "Попробуйте изменить фильтры или выберите другой трек.",
			ActionLabel: "Сбросить фильтры",
			ActionHref: "/bank",
		})
	} else {
		<p class="v-result-count">Найдено: { intString(len(page.Tasks)) }</p>
		<div class="v-card-grid">
			for _, task := range page.Tasks {
				@ui.TaskCard(page.taskCard(task))
			}
		</div>
	}
	if page.HasNext {
		<p>
			<a class="v-btn v-btn--secondary v-btn--md" href={ page.nextURL() }>Следующая страница</a>
		</p>
	}
}

templ TaskView(page *TaskPage) {
	@pageLayout(page.SEO, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Банк заданий", Path: "/bank"},
		{Title: "Задание", Path: "/bank/" + page.Task.ID.String()},
	}, page.Brand) {
		<div class="v-task-layout">
			<article class="v-task-statement">
				<div class="v-task-statement__meta">
					@ui.Badge(ui.ToneNeutral, "Задание банка")
					if page.Topic != nil {
						@ui.Badge(ui.ToneNeutral, page.Topic.Title)
					}
				</div>
				<h1>Задание</h1>
				@templ.Raw(page.StatementHTML)
				if len(page.Attachments) > 0 {
					for _, attachment := range page.Attachments {
						<figure>
							<img src={ attachment.URL } alt={ attachment.Alt }/>
						</figure>
					}
				}
			</article>
			<aside class="v-answer-panel">
				<form method="post" action={ "/bank/" + page.Task.ID.String() + "/check" } class="v-form">
					<input type="hidden" name="csrf_token" value="__CSRF__"/>
					@ui.Field(ui.FieldProps{Label: "Ваш ответ", Name: "answer", Autocomplete: "off", Required: true})
					@ui.Button(ui.ButtonProps{Label: "Проверить", Type: "submit", Variant: ui.ButtonPrimary})
				</form>
				if page.Result != nil {
					@ui.ResultPanel(ui.ResultPanelProps{
						Correct: page.Result.Correct,
						Text: page.Result.Explanation,
						NextHref: "/bank",
						NextLabel: "К банку заданий",
					})
				}
			</aside>
		</div>
	}
}

templ DemoChoiceView(page *HomePage) {
	@pageLayout(page.SEO, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Демо-диагностика", Path: "/diagnostics/demo"},
	}, page.Brand) {
		<hgroup>
			<h1>Демо-диагностика</h1>
			<p>Выберите трек, чтобы получить 5–7 заданий и увидеть результат без регистрации.</p>
		</hgroup>
		<div class="v-card-grid">
			for _, exam := range page.Exams {
				<article class={ "v-card v-track-card v-track-card--" + string(ui.SubjectTone(exam.Code)) }>
					<h3><a href={ "/diagnostics/demo?exam=" + exam.Code }>{ exam.Title }</a></h3>
					<p>Короткий набор заданий с итогом по темам.</p>
				</article>
			}
		</div>
	}
}

templ DemoView(start *DemoStart, token string) {
	@pageLayout(start.SEO, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Демо-диагностика", Path: "/diagnostics/demo"},
		{Title: start.Exam.Title, Path: "/diagnostics/demo?exam=" + start.Exam.Code},
	}, start.Brand) {
		<hgroup>
			<h1>Демо-диагностика: { start.Exam.Title }</h1>
			<p>Ответьте на задания и получите итог с разбивкой по темам.</p>
		</hgroup>
		<div class="v-demo-progress">
			@ui.Progress(ui.ProgressProps{Value: 0, Max: len(start.Tasks), Label: "Заполнено"})
		</div>
		<form method="post" action="/diagnostics/demo/check" class="v-form v-demo-form" data-demo-form>
			<input type="hidden" name="csrf_token" value="__CSRF__"/>
			<input type="hidden" name="demo_token" value={ token }/>
			for i, task := range start.Tasks {
				<article class="v-card v-demo-task" data-demo-task>
					<h2>Задание { i + 1 }</h2>
					<p>{ task.StatementMD }</p>
					@ui.Field(ui.FieldProps{Label: "Ответ", Name: "answer_" + task.ID.String(), Autocomplete: "off"})
				</article>
			}
			@ui.Button(ui.ButtonProps{Label: "Завершить диагностику", Type: "submit", Variant: ui.ButtonPrimary})
		</form>
	}
}

templ DemoResultView(result *DemoResult, brand string) {
	@pageLayout(SEOMetadata{
		Title:       "Результат демо-диагностики",
		Description: "Итог демо-диагностики и разбивка по темам.",
		Canonical:   "/diagnostics/demo",
		NoIndex:     true,
	}, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Демо-диагностика", Path: "/diagnostics/demo"},
		{Title: "Результат", Path: "/diagnostics/demo"},
	}, brand) {
		<hgroup>
			<h1>Результат демо-диагностики</h1>
			<p>Верно { result.Correct } из { result.Total }.</p>
		</hgroup>
		<div class="v-ring-grid">
			for _, topic := range result.Topics {
				@ui.Ring(ui.RingProps{Value: topic.Correct, Max: topic.Total, Label: topic.Title})
			}
		</div>
		@ui.Table(ui.TableProps{
			Head: []string{"Тема", "Верно", "Всего"},
			Rows: topicRows(result.Topics),
			Caption: "Разбивка результата по темам",
		})
		<p>Полный отчёт с рекомендациями доступен после регистрации.</p>
		<p><a class="v-btn v-btn--primary v-btn--md" href="/register">Зарегистрироваться</a></p>
	}
}

templ ArticlesView(articles []Article, next string, brand string) {
	@pageLayout(SEOMetadata{
		Title:       "Статьи и разборы",
		Description: "Публикации о подготовке к экзаменам.",
		Canonical:   "/articles",
	}, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Статьи", Path: "/articles"},
	}, brand) {
		<hgroup>
			<h1>Статьи и разборы</h1>
			<p>Материалы о подготовке к экзаменам.</p>
		</hgroup>
		if len(articles) == 0 {
			@ui.EmptyState(ui.EmptyStateProps{Title: "Опубликованных статей пока нет", Text: "Загляните позже — мы готовим новые разборы."})
		} else {
			<div class="v-card-grid">
				for _, article := range articles {
					<article class="v-card v-article-card">
						<h2><a href={ "/articles/" + article.Slug }>{ article.Title }</a></h2>
						if article.Excerpt != "" {
							<p>{ article.Excerpt }</p>
						}
						<a class="v-btn v-btn--secondary v-btn--sm" href={ "/articles/" + article.Slug }>Читать</a>
					</article>
				}
			</div>
		}
		if next != "" {
			<p><a class="v-btn v-btn--secondary v-btn--md" href={ "/articles?cursor=" + next }>Следующая страница</a></p>
		}
	}
}

templ ArticlePageView(view *ArticleView) {
	@pageLayout(view.SEO, view.Breadcrumbs, view.Brand) {
		<article class="v-prose">
			<h1>{ view.Article.Title }</h1>
			if view.Article.Excerpt != "" {
				<p><em>{ view.Article.Excerpt }</em></p>
			}
			@templ.Raw(view.ContentHTML)
		</article>
	}
}

templ leadForm(action, source string, fieldErrors map[string]string, success bool) {
	if success {
		@ui.Toast(ui.ToastProps{Tone: ui.ToneOK, Text: "Спасибо! Заявка отправлена, мы свяжемся с вами."})
	}
	if len(fieldErrors) > 0 {
		@ui.Toast(ui.ToastProps{Tone: ui.ToneErr, Text: "Проверьте поля формы."})
	}
	<form method="post" action={ action } hx-post={ action } hx-target="closest section" class="v-form">
		<input type="hidden" name="csrf_token" value="__CSRF__"/>
		<input type="hidden" name="source" value={ source }/>
		<div class="visually-hidden">
			<label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"/></label>
		</div>
		@ui.Field(ui.FieldProps{Label: "Имя", Name: "name", Required: true, MinLength: 2, MaxLength: 100, Error: fieldErrors["name"]})
		@ui.Field(ui.FieldProps{Label: "Контакт", Name: "contact", Required: true, MinLength: 3, MaxLength: 200, Placeholder: "email или телефон", Error: fieldErrors["contact"]})
		@ui.Field(ui.FieldProps{Label: "Комментарий", Name: "comment", Multiline: true, MaxLength: 2000, Error: fieldErrors["comment"]})
		@ui.Button(ui.ButtonProps{Label: "Отправить заявку", Type: "submit", Variant: ui.ButtonPrimary})
	</form>
}

templ LeadFormView(source string, fieldErrors map[string]string, success bool, brand string) {
	@pageLayout(SEOMetadata{
		Title:       "Оставить заявку",
		Description: "Заявка на подготовку к экзаменам.",
		Canonical:   "/leads",
		NoIndex:     true,
	}, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Заявка", Path: "/leads"},
	}, brand) {
		<hgroup>
			<h1>Оставить заявку</h1>
			<p>Мы свяжемся с вами и поможем выбрать программу.</p>
		</hgroup>
		<section>
			@leadForm("/leads", source, fieldErrors, success)
		</section>
	}
}

templ ErrorView(status int, message string, brand string) {
	@pageLayout(SEOMetadata{
		Title:   message,
		NoIndex: true,
	}, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: message, Path: "/"},
	}, brand) {
		<hgroup>
			<h1>{ intString(status) }</h1>
		</hgroup>
		@ui.EmptyState(ui.EmptyStateProps{
			Title: message,
			Text: "Проверьте адрес страницы или вернитесь на главную.",
			ActionLabel: "На главную",
			ActionHref: "/",
			Error: true,
		})
	}
}

templ DemoUnavailableView(exams []content.Exam, brand string) {
	@pageLayout(SEOMetadata{
		Title:       "Демо-диагностика",
		Description: "Для выбранного трека пока недостаточно заданий.",
		Canonical:   "/diagnostics/demo",
		NoIndex:     true,
	}, []Breadcrumb{
		{Title: "Главная", Path: "/"},
		{Title: "Демо-диагностика", Path: "/diagnostics/demo"},
	}, brand) {
		<hgroup>
			<h1>Демо-диагностика</h1>
		</hgroup>
		@ui.EmptyState(ui.EmptyStateProps{
			Title: "Для выбранного трека пока недостаточно опубликованных заданий",
			Text: "Выберите другой трек.",
			ActionLabel: "К выбору трека",
			ActionHref: "/diagnostics/demo",
		})
		<div class="v-card-grid">
			for _, exam := range exams {
				<article class={ "v-card v-track-card v-track-card--" + string(ui.SubjectTone(exam.Code)) }>
					<h3><a href={ "/diagnostics/demo?exam=" + exam.Code }>{ exam.Title }</a></h3>
				</article>
			}
		</div>
	}
}
