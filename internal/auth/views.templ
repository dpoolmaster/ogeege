package auth

import (
	"oge-ege/internal/shared/render"
	"oge-ege/internal/shared/render/ui"
)

templ LoginPage(data PageData) {
	@render.Layout(render.Chrome{Brand: data.Brand}, "Вход") {
		<hgroup>
			<h1>Вход</h1>
			<p>Войдите, чтобы продолжить подготовку.</p>
		</hgroup>
		if data.Error != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneErr, Text: data.Error})
		}
		if data.Message != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneOK, Text: data.Message})
		}
		<form method="post" action="/login" class="v-form">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			@ui.Field(ui.FieldProps{Label: "Email", Name: "email", Type: "email", Value: data.Email, Autocomplete: "email", Required: true})
			@ui.Field(ui.FieldProps{Label: "Пароль", Name: "password", Type: "password", Autocomplete: "current-password", Required: true})
			@ui.Button(ui.ButtonProps{Label: "Войти", Type: "submit", Variant: ui.ButtonPrimary})
		</form>
		<p>
			Нет аккаунта? <a href="/register">Зарегистрироваться</a>
		</p>
		<p>
			<a href="/password/reset">Забыли пароль?</a>
		</p>
	}
}

templ RegisterPage(data PageData) {
	@render.Layout(render.Chrome{Brand: data.Brand}, "Регистрация") {
		<hgroup>
			<h1>Регистрация</h1>
			<p>Создайте аккаунт ученика или родителя.</p>
		</hgroup>
		if data.Error != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneErr, Text: data.Error})
		}
		<form method="post" action="/register" class="v-form">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			@ui.Field(ui.FieldProps{Label: "Email", Name: "email", Type: "email", Value: data.Email, Autocomplete: "email", Required: true})
			@ui.Field(ui.FieldProps{Label: "Пароль", Name: "password", Type: "password", Autocomplete: "new-password", Hint: "Не менее 10 символов.", Required: true, MinLength: 10})
			<div class="v-field">
				<label for="field-role">Роль</label>
				<select id="field-role" name="role">
					<option value="student">Ученик</option>
					<option value="parent">Родитель</option>
				</select>
			</div>
			<label class="v-check">
				<input type="checkbox" name="personal_data" value="true"/>
				Согласен на обработку персональных данных
			</label>
			<label class="v-check">
				<input type="checkbox" name="legal_representative" value="true"/>
				Есть согласие законного представителя (для несовершеннолетних)
			</label>
			@ui.Button(ui.ButtonProps{Label: "Создать аккаунт", Type: "submit", Variant: ui.ButtonPrimary})
		</form>
		<p>
			Уже есть аккаунт? <a href="/login">Войти</a>
		</p>
	}
}

templ VerifyEmailPage(data PageData) {
	@render.Layout(render.Chrome{Brand: data.Brand}, "Подтверждение email") {
		<hgroup>
			<h1>Подтверждение email</h1>
			<p>Перейдите по ссылке из письма или подтвердите адрес кнопкой ниже.</p>
		</hgroup>
		if data.Error != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneErr, Text: data.Error})
		}
		if data.Message != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneOK, Text: data.Message})
		}
		if data.Token != "" {
			<form method="post" action="/verify-email" class="v-form">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<input type="hidden" name="token" value={ data.Token }/>
				@ui.Button(ui.ButtonProps{Label: "Подтвердить email", Type: "submit", Variant: ui.ButtonPrimary})
			</form>
		}
		<form method="post" action="/resend-verification" class="v-form">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			@ui.Field(ui.FieldProps{Label: "Отправить письмо повторно", Name: "email", Type: "email", Value: data.Email, Autocomplete: "email", Required: true})
			@ui.Button(ui.ButtonProps{Label: "Отправить", Type: "submit", Variant: ui.ButtonSecondary})
		</form>
	}
}

templ PasswordResetPage(data PageData) {
	@render.Layout(render.Chrome{Brand: data.Brand}, "Сброс пароля") {
		<hgroup>
			<h1>Сброс пароля</h1>
		</hgroup>
		if data.Error != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneErr, Text: data.Error})
		}
		if data.Message != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneOK, Text: data.Message})
		}
		if data.Token != "" {
			<form method="post" action="/password/reset" class="v-form">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<input type="hidden" name="token" value={ data.Token }/>
				@ui.Field(ui.FieldProps{Label: "Новый пароль", Name: "new_password", Type: "password", Autocomplete: "new-password", Required: true, MinLength: 10})
				@ui.Button(ui.ButtonProps{Label: "Сохранить пароль", Type: "submit", Variant: ui.ButtonPrimary})
			</form>
		} else {
			<form method="post" action="/password/reset-request" class="v-form">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				@ui.Field(ui.FieldProps{Label: "Email", Name: "email", Type: "email", Value: data.Email, Autocomplete: "email", Required: true})
				@ui.Button(ui.ButtonProps{Label: "Отправить ссылку", Type: "submit", Variant: ui.ButtonPrimary})
			</form>
		}
		<p>
			<a href="/login">Вернуться ко входу</a>
		</p>
	}
}

templ AccountPage(data PageData) {
	@render.Layout(render.Chrome{Brand: data.Brand}, "Аккаунт") {
		<hgroup>
			<h1>Аккаунт</h1>
			<p>Вы вошли как { data.Email }.</p>
		</hgroup>
		if data.Error != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneErr, Text: data.Error})
		}
		if data.Message != "" {
			@ui.Toast(ui.ToastProps{Tone: ui.ToneOK, Text: data.Message})
		}
		<dl>
			<dt>Роль</dt>
			<dd>{ data.RoleLabel }</dd>
			<dt>Статус</dt>
			<dd>{ data.StatusLabel }</dd>
		</dl>
		<nav class="v-actions" aria-label="Разделы аккаунта">
			@ui.Button(ui.ButtonProps{Label: "Личный кабинет", Href: "/app", Variant: ui.ButtonPrimary})
			@ui.Button(ui.ButtonProps{Label: "Учебная цель", Href: "/app/goal", Variant: ui.ButtonSecondary})
		</nav>
		<form method="post" action="/logout" class="v-form">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			@ui.Button(ui.ButtonProps{Label: "Выйти", Type: "submit", Variant: ui.ButtonSecondary})
		</form>
	}
}

templ LogoutPage(data PageData) {
	@render.Layout(render.Chrome{Brand: data.Brand}, "Выход") {
		<hgroup>
			<h1>Выход</h1>
			<p>Вы вошли как { data.Email }.</p>
		</hgroup>
		<form method="post" action="/logout" class="v-form">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			@ui.Button(ui.ButtonProps{Label: "Выйти", Type: "submit", Variant: ui.ButtonPrimary})
		</form>
		<p>
			<a href="/account">Вернуться в аккаунт</a>
		</p>
	}
}
