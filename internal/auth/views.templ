package auth

import "oge-ege/internal/shared/render"

templ LoginPage(data PageData) {
	@render.Layout("Вход") {
		<hgroup>
			<h1>Вход</h1>
			<p>Войдите, чтобы продолжить подготовку.</p>
		</hgroup>
		if data.Error != "" {
			<article role="alert">{ data.Error }</article>
		}
		if data.Message != "" {
			<article>{ data.Message }</article>
		}
		<form method="post" action="/login">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<label>
				Email
				<input type="email" name="email" value={ data.Email } autocomplete="email" required/>
			</label>
			<label>
				Пароль
				<input type="password" name="password" autocomplete="current-password" required/>
			</label>
			<button type="submit">Войти</button>
		</form>
		<p>
			Нет аккаунта? <a href="/register">Зарегистрироваться</a>
		</p>
		<p>
			<a href="/password/reset">Забыли пароль?</a>
		</p>
	}
}

templ RegisterPage(data PageData) {
	@render.Layout("Регистрация") {
		<hgroup>
			<h1>Регистрация</h1>
			<p>Создайте аккаунт ученика или родителя.</p>
		</hgroup>
		if data.Error != "" {
			<article role="alert">{ data.Error }</article>
		}
		<form method="post" action="/register">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<label>
				Email
				<input type="email" name="email" value={ data.Email } autocomplete="email" required/>
			</label>
			<label>
				Пароль
				<input type="password" name="password" autocomplete="new-password" minlength="10" required/>
				<small>Не менее 10 символов.</small>
			</label>
			<label>
				Роль
				<select name="role">
					<option value="student">Ученик</option>
					<option value="parent">Родитель</option>
				</select>
			</label>
			<label>
				<input type="checkbox" name="personal_data" value="true"/>
				Согласен на обработку персональных данных
			</label>
			<label>
				<input type="checkbox" name="legal_representative" value="true"/>
				Есть согласие законного представителя (для несовершеннолетних)
			</label>
			<button type="submit">Создать аккаунт</button>
		</form>
		<p>
			Уже есть аккаунт? <a href="/login">Войти</a>
		</p>
	}
}

templ VerifyEmailPage(data PageData) {
	@render.Layout("Подтверждение email") {
		<hgroup>
			<h1>Подтверждение email</h1>
			<p>Перейдите по ссылке из письма или подтвердите адрес кнопкой ниже.</p>
		</hgroup>
		if data.Error != "" {
			<article role="alert">{ data.Error }</article>
		}
		if data.Message != "" {
			<article>{ data.Message }</article>
		}
		if data.Token != "" {
			<form method="post" action="/verify-email">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<input type="hidden" name="token" value={ data.Token }/>
				<button type="submit">Подтвердить email</button>
			</form>
		}
		<form method="post" action="/resend-verification">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<label>
				Отправить письмо повторно
				<input type="email" name="email" value={ data.Email } autocomplete="email" required/>
			</label>
			<button type="submit">Отправить</button>
		</form>
	}
}

templ PasswordResetPage(data PageData) {
	@render.Layout("Сброс пароля") {
		<hgroup>
			<h1>Сброс пароля</h1>
		</hgroup>
		if data.Error != "" {
			<article role="alert">{ data.Error }</article>
		}
		if data.Message != "" {
			<article>{ data.Message }</article>
		}
		if data.Token != "" {
			<form method="post" action="/password/reset">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<input type="hidden" name="token" value={ data.Token }/>
				<label>
					Новый пароль
					<input type="password" name="new_password" autocomplete="new-password" minlength="10" required/>
				</label>
				<button type="submit">Сохранить пароль</button>
			</form>
		} else {
			<form method="post" action="/password/reset-request">
				<input type="hidden" name="csrf_token" value={ data.CSRF }/>
				<label>
					Email
					<input type="email" name="email" value={ data.Email } autocomplete="email" required/>
				</label>
				<button type="submit">Отправить ссылку</button>
			</form>
		}
		<p>
			<a href="/login">Вернуться ко входу</a>
		</p>
	}
}

templ AccountPage(data PageData) {
	@render.Layout("Аккаунт") {
		<hgroup>
			<h1>Аккаунт</h1>
			<p>Вы вошли как { data.Email }.</p>
		</hgroup>
		if data.Error != "" {
			<article role="alert">{ data.Error }</article>
		}
		if data.Message != "" {
			<article>{ data.Message }</article>
		}
		<dl>
			<dt>Роль</dt>
			<dd>{ data.RoleLabel }</dd>
			<dt>Статус</dt>
			<dd>{ data.StatusLabel }</dd>
		</dl>
		<form method="post" action="/logout">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<button type="submit">Выйти</button>
		</form>
	}
}

templ LogoutPage(data PageData) {
	@render.Layout("Выход") {
		<hgroup>
			<h1>Выход</h1>
			<p>Вы вошли как { data.Email }.</p>
		</hgroup>
		<form method="post" action="/logout">
			<input type="hidden" name="csrf_token" value={ data.CSRF }/>
			<button type="submit">Выйти</button>
		</form>
		<p>
			<a href="/account">Вернуться в аккаунт</a>
		</p>
	}
}
